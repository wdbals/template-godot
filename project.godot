; Engine configuration file.
; Prefer editing it from the Godot editor when possible.

config_version=5

[application]

config/name="Puppies Game"
run/main_scene="res://game_content/scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/image="res://game_content/icon.png"
config/icon="res://game_content/icon.png"

[audio]

buses/default_bus_layout="res://puppy_core/audio/default_bus_layout.tres"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":13)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":14)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":11)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":12)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":7)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventJoypadButton,"button_index":0)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":2)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadMotion,"axis":5,"axis_value":1.0)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}
toggle_debug={
"deadzone": 0.2,
"events": []
}

[layer_names]

2d_render/layer_1="DEFAULT"
2d_render/layer_2="BACKGROUND"
2d_render/layer_3="WORLD"
2d_render/layer_4="CHARACTERS"
2d_render/layer_5="FOREGROUND"
2d_render/layer_6="EFFECTS"
2d_render/layer_7="UI"
3d_render/layer_1="DEFAULT"
3d_render/layer_2="WORLD"
3d_render/layer_3="PLAYER"
3d_render/layer_4="ENEMIES"
3d_render/layer_5="EFFECTS"
3d_render/layer_6="UI"

2d_physics/layer_1="WORLD"
2d_physics/layer_2="PLAYER_BODY"
2d_physics/layer_3="ENEMY_BODY"
2d_physics/layer_4="PLAYER_HURTBOX"
2d_physics/layer_5="PLAYER_HITBOX"
2d_physics/layer_6="ENEMY_HURTBOX"
2d_physics/layer_7="ENEMY_HITBOX"
2d_physics/layer_8="PLAYER_PROJECTILE"
2d_physics/layer_9="ENEMY_PROJECTILE"
2d_physics/layer_10="ITEMS"
2d_physics/layer_11="PROPS"
2d_physics/layer_12="INTERACTABLES"
2d_physics/layer_13="TRIGGERS"
3d_physics/layer_1="WORLD"
3d_physics/layer_2="PLAYER_BODY"
3d_physics/layer_3="ENEMY_BODY"
3d_physics/layer_4="PLAYER_HURTBOX"
3d_physics/layer_5="PLAYER_HITBOX"
3d_physics/layer_6="ENEMY_HURTBOX"
3d_physics/layer_7="ENEMY_HITBOX"
3d_physics/layer_8="PLAYER_PROJECTILE"
3d_physics/layer_9="ENEMY_PROJECTILE"
3d_physics/layer_10="ITEMS"
3d_physics/layer_11="PROPS"
3d_physics/layer_12="INTERACTABLES"
3d_physics/layer_13="TRIGGERS"

[physics]

2d/default_gravity=980.0
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
